{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL}",
  "provider": {
    "opper": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Opper AI",
      "env": ["OPPER_API_KEY"],
      "options": {
        "baseURL": "https://api.opper.ai/v3/compat",
        "apiKey": "{env:OPPER_API_KEY}"
      }
    }
  },
  "server": {
    "hostname": "0.0.0.0",
    "port": 4096
  }
}
