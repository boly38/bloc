# Launch mode: false (or unset) = OpenCode only; true = OpenCode + Telegram.
TELEGRAM_ENABLED=false

# Required only when TELEGRAM_ENABLED=true. Create the token with @BotFather.
TELEGRAM_BOT_TOKEN=

# Required only when TELEGRAM_ENABLED=true. Comma-separated allowed chat IDs.
# Discover the first ID safely with `make telegram-chat-id` before enabling Telegram.
TELEGRAM_ALLOWED_CHAT_IDS=

# Temporary, sanitized OpenCode cost/token diagnostics for an authorized test exchange.
# Keep disabled normally; output is written to /data/cost-diagnostics.jsonl in the bridge volume.
TELEGRAM_COST_DIAGNOSTICS=false

# Optional /health reachability check from the bridge to Opper (no key or inference).
# Does not validate OpenCode's provider credentials, credits, or model availability.
TELEGRAM_HEALTH_OPPER_ENABLED=false

# Opper AI provider (https://opper.ai).
OPPER_API_KEY=

# Optional GitHub CLI authentication for the OpenCode agent. Never commit a real token.
GH_TOKEN=

# Model ID provided by Opper, without the "opper/" prefix.
OPPER_MODEL=gpt-5.6-luna

# Default OpenCode variant for this model.
OPPER_VARIANT=medium

# BLOC is qualified with OpenCode v1.19.3; OpenCode v2 is not yet qualified.
# Browse OpenCode image tags and digests for the main and repair Compose files at:
# https://github.com/anomalyco/opencode/pkgs/container/opencode
# Pin the digest for a version you have qualified; do not use a floating tag.
OPENCODE_IMAGE=ghcr.io/anomalyco/opencode@sha256:6ebc13097f2381301220abe9d1b2a54f50cd1603a910dc1c66e93d8f2c4e8ebb
