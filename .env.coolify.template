# Example values to configure on the Coolify Compose resource.
# Replace placeholders for the providers and services you enable; never commit real credentials.

# Enable the Telegram service's Docker Compose profile.
# Configure this as a Coolify resource/build environment variable, not under a
# service's `environment:` section. This configuration was validated on Coolify.
COMPOSE_PROFILES=telegram

# Default provider: Opper AI. OPPER_API_KEY is required only when using Opper.
OPPER_API_KEY=
OPPER_MODEL=gpt-5.6-luna
OPPER_VARIANT=medium
# Optional complete OpenCode model reference for a connected provider, e.g.
# provider/model#variant. Set this in Coolify to make Telegram use a non-Opper model.
OPENCODE_MODEL=

# BLOC is qualified with OpenCode v1.19.3; OpenCode v2 is not yet qualified.
# Browse OpenCode image tags and digests at:
# https://github.com/anomalyco/opencode/pkgs/container/opencode
# Pin the digest for a version you have qualified; do not use a floating tag.
OPENCODE_IMAGE=ghcr.io/anomalyco/opencode@sha256:6ebc13097f2381301220abe9d1b2a54f50cd1603a910dc1c66e93d8f2c4e8ebb

# Optional GitHub CLI token passed only to the OpenCode service.
# Use a dedicated, least-privilege token; leave empty to disable GitHub authentication.
GH_TOKEN=

# Telegram bot created with @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated Telegram chat IDs allowed to use the bot.
# Replace this example ID with your own numeric chat ID(s).
TELEGRAM_ALLOWED_CHAT_IDS=123456789

# Maximum monitoring time for one Telegram request (5 days by default).
OPENCODE_REQUEST_MAX_DURATION_SECONDS=432000

# Optional /health Opper API reachability check, without credentials or inference.
TELEGRAM_HEALTH_OPPER_ENABLED=false
